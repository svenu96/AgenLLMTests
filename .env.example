# Environment Variables Configuration
# Copy this file to .env and fill in your API keys

# OpenAI API Key (required for most LLM functionality)
OPENAI_API_KEY=your_openai_api_key_here

# Hugging Face API Token (optional, for some models)
HUGGINGFACE_API_TOKEN=your_huggingface_token_here

# Model Settings
DEFAULT_LLM_MODEL=gpt-3.5-turbo
DEFAULT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Application Settings
APP_NAME=LLM Study & Agent Platform
APP_VERSION=0.1.0
DEBUG=false

# Database Settings (if using external databases)
# VECTOR_DB_URL=http://localhost:8002
# POSTGRES_URL=postgresql://user:password@localhost:5432/llm_platform

# Logging Settings
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501

# Security Settings (change in production)
SECRET_KEY=your-secret-key-here
JWT_SECRET=your-jwt-secret-here

# Resource Limits
MAX_UPLOAD_SIZE=50MB
MAX_TOKENS_PER_REQUEST=2000
RATE_LIMIT_PER_MINUTE=60